# Server chỉ bind vào máy local theo mặc định.
HOST=127.0.0.1
PORT=43123

# Tùy chọn: có thể dùng biến môi trường thay cho macOS Keychain.
# Không commit API key thật vào Git.
ELEVENLABS_API_KEY=

# Tùy chọn: backend VoiceStudio local (không cần nếu chưa cài VoiceStudio).
VOICESTUDIO_URL=http://127.0.0.1:3900

# Tùy chọn: đổi nơi lưu project/cache/output.
# CVS_DATA_ROOT=/duong/dan/ban/muon
